---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import { Image } from 'astro:assets';
import { fotoDoServico } from '../data/fotos';
import heroFoto from '../assets/hero.jpg';
import { site } from '../data/site';
import { servicos } from '../data/servicos';
import { bairrosPorZona, bairroPath, zonasPrioritarias } from '../data/bairros';
import { faqSchema } from '../data/schema';
import { getCollection } from 'astro:content';

const faq = [
  {
    q: 'O atendimento é 24 horas mesmo?',
    a: 'Sim. Atendemos 24 horas por dia, 7 dias por semana, incluindo fins de semana e feriados, em Brasília e em todo o Distrito Federal.',
  },
  {
    q: 'Em quanto tempo vocês chegam?',
    a: `Nossa equipe chega em até ${site.arrivalMinutes} minutos nas regiões atendidas.`,
  },
  {
    q: 'Vocês quebram piso ou parede para desentupir?',
    a: 'Na grande maioria dos casos, não. Usamos máquinas de mola rotativa e equipamentos de pressão que alcançam o entupimento por dentro do cano. Abertura só quando o cano está quebrado, e sempre com seu aceite antes.',
  },
  {
    q: 'Quais serviços vocês fazem?',
    a: 'Somos especializados em desentupimento: vaso sanitário, pia, ralo, esgoto e cano.',
  },
  {
    q: 'Os serviços têm garantia?',
    a: `Sim. Todos os desentupimentos da ${site.name} têm garantia.`,
  },
  {
    q: 'Como chamo a desentupidora?',
    a: `É só chamar no WhatsApp ou ligar. Conte o que entupiu, de preferência com uma foto ou vídeo, e a equipe sai na hora para chegar em até ${site.arrivalMinutes} minutos.`,
  },
];

const fotoEquipe = fotoDoServico('desentupimento-de-cano');
const temGaleria = servicos.some((s) => fotoDoServico(s.slug));

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
---

<Base
  title={`Desentupidora 24 Horas em Brasília | Chegamos em ${site.arrivalMinutes} min`}
  description={site.description}
  schema={[faqSchema(faq)]}
>
  <section class="hero hero-home">
    {
      (
        <Image
          class="hero-bg"
          src={heroFoto}
          alt=""
          widths={[480, 800, 1200, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="container hero-center">
      <span class="eyebrow">Desentupidora em Brasília - DF · Plantão 24h</span>
      <h1>Desentupidora 24 horas em Brasília: <em>chegamos em até {site.arrivalMinutes} minutos</em></h1>
      <p class="hero-lead">Vaso, pia, ralo, esgoto ou cano entupido? Desentupimos hoje, a qualquer hora, sem quebra-quebra e com garantia.</p>
      <CtaButtons />
      <ul class="hero-badges">
        <li><Icon name="clock" size={22} /> <span>Atendimento 24h</span></li>
        <li><Icon name="bolt" size={22} /> <span>Chegada em até {site.arrivalMinutes} min</span></li>
        <li><Icon name="shield" size={22} /> <span>Serviço com garantia</span></li>
      </ul>
    </div>
  </section>

  <section class="trust" aria-label="Diferenciais">
    <div class="container trust-grid">
      <div class="trust-item"><Icon name="clock" size={34} /><div><strong>24 horas</strong><span>Todos os dias, inclusive feriados</span></div></div>
      <div class="trust-item"><Icon name="bolt" size={34} /><div><strong>{site.arrivalMinutes} minutos</strong><span>Tempo de chegada</span></div></div>
      <div class="trust-item"><Icon name="shield" size={34} /><div><strong>Garantia</strong><span>Em todos os serviços</span></div></div>
      <div class="trust-item"><Icon name="pin" size={34} /><div><strong>Todo o DF</strong><span>Plano Piloto e regiões</span></div></div>
    </div>
  </section>

  <section class="section section-soft" id="servicos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nossos serviços</span>
        <h2>Desentupimento em Brasília</h2>
        <p>Somos especialistas em uma coisa só: desentupir. Casas, apartamentos, condomínios e comércios.</p>
      </div>
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Como funciona</span>
        <h2>Do chamado ao problema resolvido</h2>
        <p>Sem enrolação: você chama, a gente chega e resolve.</p>
      </div>
      <div class="steps">
        <div class="step-card">
          <h3>Chame no WhatsApp ou ligue</h3>
          <p>Conte o que entupiu. Se puder, mande uma foto ou um vídeo do problema.</p>
        </div>
        <div class="step-card">
          <h3>Chegamos em até {site.arrivalMinutes} minutos</h3>
          <p>Assim que você chama, a equipe já sai para o endereço. Em até {site.arrivalMinutes} minutos ela está aí com o equipamento.</p>
        </div>
        <div class="step-card">
          <h3>Desentupido com garantia</h3>
          <p>Desentupimos, testamos o escoamento na sua frente e deixamos o local limpo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class:list={['container', { 'about-grid': fotoEquipe }]}>
      {
        fotoEquipe && (
          <div class="about-photo">
            <Image src={fotoEquipe.src} alt={fotoEquipe.alt} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 460px" />
          </div>
        )
      }
      <div>
      <div class="section-head">
        <span class="eyebrow">Por que a {site.name}</span>
        <h2>Desentupidora de confiança, a qualquer hora</h2>
        <p>Equipe equipada para desentupir desde a pia da cozinha até a coluna de esgoto de um prédio.</p>
      </div>
      <div class="features">
        <div class="feature">
          <Icon name="clock" size={30} />
          <div><h3>Plantão 24 horas</h3><p>Entupimento não espera horário comercial. Atendemos de madrugada, fins de semana e feriados.</p></div>
        </div>
        <div class="feature">
          <Icon name="bolt" size={30} />
          <div><h3>Chegamos em {site.arrivalMinutes} minutos</h3><p>Esgoto voltando não pode esperar. Em até {site.arrivalMinutes} minutos a equipe está na sua porta.</p></div>
        </div>
        <div class="feature">
          <Icon name="shield" size={30} />
          <div><h3>Garantia no serviço</h3><p>Todo desentupimento sai com garantia. Se voltar a entupir no prazo, voltamos para resolver.</p></div>
        </div>
        <div class="feature">
          <Icon name="check" size={30} />
          <div><h3>Sem quebra-quebra</h3><p>Máquinas de mola rotativa e equipamentos de pressão alcançam o entupimento por dentro do cano, sem abrir piso nem parede.</p></div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <CtaBand />

  {
    temGaleria && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Nossos serviços</span>
            <h2>Desentupimento sem quebra-quebra</h2>
            <p>Máquinas de mola rotativa e equipamentos profissionais para cada tipo de entupimento.</p>
          </div>
          <Gallery limit={8} />
        </div>
      </section>
    )
  }

  <section class="section section-soft" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Áreas atendidas</span>
        <h2>Desentupidora perto de você</h2>
        <p>Atendemos Brasília e as regiões administrativas do Distrito Federal.</p>
      </div>
      <div class="zones">
        {
          bairrosPorZona().map((g) => (
            <div class:list={['zone', { 'is-priority': zonasPrioritarias.includes(g.zona) }]}>
              <h3>
                {g.zona}
                {zonasPrioritarias.includes(g.zona) && <span class="tag">Foco</span>}
              </h3>
              <ul>
                {g.bairros.map((b) => (
                  <li>
                    <a href={bairroPath(b)}>
                      <Icon name="pin" size={16} /> Desentupidora em {b.nome}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Blog</span>
            <h2>Dicas contra entupimento</h2>
          </div>
          <div class="posts">
            {posts.map((p) => (
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.data.toISOString()}>{p.data.data.toLocaleDateString('pt-BR')}</time>
                <h3>{p.data.titulo}</h3>
                <p>{p.data.descricao}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section-soft">
    <div class="container" style="max-width: 860px">
      <div class="section-head">
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2>Perguntas frequentes</h2>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand title="Precisa desentupir agora?" />
</Base>
